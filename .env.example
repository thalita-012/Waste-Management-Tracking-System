# Copy this file to .env and put your real local values there.
# Do not commit real passwords, JWT secrets, or Bakong tokens.

PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234567
DB_NAME=wmts
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/wmts"

# JWT Secret (Generate a strong random string for production)
JWT_SECRET=replace_with_a_long_random_secret_key_here

# Bakong Payment Gateway (Cambodia)
# Get your credentials from: https://www.bakong.nbc.gov.kh/
BAKONG_API_BASE_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=your_bakong_test_token_here
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_INFORMATION=
BAKONG_MERCHANT_NAME=Waste Management
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_QR_EXPIRATION_MINUTES=5
