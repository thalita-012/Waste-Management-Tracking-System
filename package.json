{
  "name": "waste-management-tracking-system",
  "version": "1.0.0",
  "description": "A waste management tracking system",
  "type": "module",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "db:setup": "npm --prefix backend run db:setup",
    "start": "node backend/dist/server.js",
    "dev": "npm --prefix backend run dev",
    "watch": "npm --prefix backend run watch",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thalita-012/Waste-Management-Tracking-System.git"
  },
  "keywords": [
    "waste",
    "management",
    "tracking"
  ],
  "author": "thalita-012",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thalita-012/Waste-Management-Tracking-System/issues"
  },
  "homepage": "https://github.com/thalita-012/Waste-Management-Tracking-System#readme"
}
